<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The floating iPod. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Click-wheel haptics. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Artwork some players share as web URLs. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Music apps, so the iPod can show the playing app's name. -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
    </queries>

    <application
        android:name=".IPodifyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible: asks for "Display over other apps", then opens the iPod. -->
        <activity
            android:name=".pod.ClassipodActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- The iPod as the lock screen while it is open: shown when locked, in a
             task of its own so unlocking returns to whatever was open. -->
        <activity
            android:name=".pod.LockPodActivity"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:taskAffinity="com.ipodify.app.lockpod"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:exported="false"
            tools:targetApi="o_mr1" />

        <service
            android:name=".pod.FloatingPodService"
            android:exported="false" />

        <!-- Notification access: what lets iPodify read and control other apps'
             media sessions. No notifications are read. -->
        <service
            android:name=".media.MediaListenerService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
